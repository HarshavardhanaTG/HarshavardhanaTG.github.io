<svg viewBox="0 0 240 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Abstract line drawing of a human figure with a network of sensor nodes at the joints and a signal halo around the head, representing embodied intelligence">
  <!-- cognition halo -->
  <circle cx="120" cy="40" r="34" fill="none" stroke="var(--global-theme-color)" stroke-width="1" stroke-dasharray="2 6" opacity="0.5" />
  <circle cx="120" cy="40" r="26" fill="none" stroke="var(--global-theme-color)" stroke-width="1" stroke-dasharray="2 6" opacity="0.35" />

  <!-- skeleton -->
  <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none">
    <circle cx="120" cy="40" r="16" />
    <line x1="120" y1="56" x2="120" y2="85" />
    <line x1="85" y1="85" x2="155" y2="85" />
    <line x1="85" y1="85" x2="65" y2="140" />
    <line x1="65" y1="140" x2="55" y2="190" />
    <line x1="155" y1="85" x2="175" y2="140" />
    <line x1="175" y1="140" x2="185" y2="190" />
    <line x1="120" y1="85" x2="120" y2="175" />
    <line x1="100" y1="175" x2="140" y2="175" />
    <line x1="100" y1="175" x2="100" y2="235" />
    <line x1="100" y1="235" x2="95" y2="295" />
    <line x1="140" y1="175" x2="140" y2="235" />
    <line x1="140" y1="235" x2="145" y2="295" />
  </g>

  <!-- neuromuscular signal network -->
  <g stroke="var(--global-theme-color)" stroke-width="1" stroke-dasharray="3 5" opacity="0.45" fill="none">
    <line x1="55" y1="190" x2="185" y2="190" />
    <line x1="65" y1="140" x2="140" y2="175" />
    <line x1="175" y1="140" x2="100" y2="175" />
    <line x1="55" y1="190" x2="100" y2="235" />
    <line x1="185" y1="190" x2="140" y2="235" />
  </g>

  <!-- sensor nodes -->
  <g fill="var(--global-theme-color)">
    <circle cx="85" cy="85" r="4" />
    <circle cx="155" cy="85" r="4" />
    <circle cx="65" cy="140" r="4" />
    <circle cx="175" cy="140" r="4" />
    <circle cx="55" cy="190" r="5" />
    <circle cx="185" cy="190" r="5" />
    <circle cx="100" cy="175" r="4" />
    <circle cx="140" cy="175" r="4" />
    <circle cx="100" cy="235" r="4" />
    <circle cx="140" cy="235" r="4" />
    <circle cx="95" cy="295" r="5" />
    <circle cx="145" cy="295" r="5" />
  </g>
</svg>
