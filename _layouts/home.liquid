---
layout: default
---
<div class="home-minimal">
  <header class="home-header">
    <h1 class="home-name">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.subtitle %}
      <p class="home-subtitle">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <div class="home-figure" aria-hidden="true">{% include embodied_intelligence.liquid %}</div>

  <div class="home-intro">{{ content }}</div>
</div>
